{
  "id": "tpl-modern-smart-home",
  "title": "Modern Smart Home",
  "views": [
    {
      "id": "view-overview",
      "title": "Overview",
      "path": "overview",
      "icon": "mdi:home",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-weather",
          "type": "weather-forecast",
          "colSpan": 6,
          "config": {
            "entity": "weather.home",
            "show_forecast": true,
            "forecast_type": "daily"
          }
        },
        {
          "id": "card-quick-status",
          "type": "glance",
          "colSpan": 6,
          "config": {
            "title": "Quick Status",
            "entities": [
              "light.living_room",
              "climate.living_room",
              "lock.front_door",
              "binary_sensor.front_door",
              "cover.garage_door",
              "alarm_control_panel.home"
            ],
            "show_state": true,
            "columns": 3
          }
        },
        {
          "id": "card-people",
          "type": "glance",
          "colSpan": 4,
          "config": {
            "title": "Who's Home",
            "entities": ["person.john", "person.sarah", "person.emma"],
            "show_state": true
          }
        },
        {
          "id": "card-lights-summary",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Lights",
            "entities": [
              "light.living_room",
              "light.kitchen",
              "light.bedroom",
              "light.office"
            ]
          }
        },
        {
          "id": "card-climate-summary",
          "type": "thermostat",
          "colSpan": 4,
          "config": {
            "entity": "climate.living_room",
            "name": "Living Room"
          }
        },
        {
          "id": "card-energy-today",
          "type": "statistics-graph",
          "colSpan": 12,
          "config": {
            "title": "Energy Today",
            "entities": [{"entity": "sensor.energy_today"}],
            "period": "day",
            "chart_type": "bar"
          }
        }
      ]
    },
    {
      "id": "view-lights",
      "title": "Lights",
      "path": "lights",
      "icon": "mdi:lightbulb",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-light-living",
          "type": "light",
          "colSpan": 4,
          "config": {
            "entity": "light.living_room",
            "name": "Living Room"
          }
        },
        {
          "id": "card-light-kitchen",
          "type": "light",
          "colSpan": 4,
          "config": {
            "entity": "light.kitchen",
            "name": "Kitchen"
          }
        },
        {
          "id": "card-light-bedroom",
          "type": "light",
          "colSpan": 4,
          "config": {
            "entity": "light.bedroom",
            "name": "Bedroom"
          }
        },
        {
          "id": "card-light-office",
          "type": "light",
          "colSpan": 4,
          "config": {
            "entity": "light.office",
            "name": "Office"
          }
        },
        {
          "id": "card-light-bathroom",
          "type": "light",
          "colSpan": 4,
          "config": {
            "entity": "light.bathroom",
            "name": "Bathroom"
          }
        },
        {
          "id": "card-light-garage",
          "type": "light",
          "colSpan": 4,
          "config": {
            "entity": "light.garage",
            "name": "Garage"
          }
        },
        {
          "id": "card-light-history",
          "type": "history-graph",
          "colSpan": 12,
          "config": {
            "title": "Light History",
            "entities": [
              {"entity": "light.living_room"},
              {"entity": "light.kitchen"},
              {"entity": "light.bedroom"}
            ],
            "hours_to_show": 24
          }
        }
      ]
    },
    {
      "id": "view-climate",
      "title": "Climate",
      "path": "climate",
      "icon": "mdi:thermometer",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-thermo-living",
          "type": "thermostat",
          "colSpan": 4,
          "config": {
            "entity": "climate.living_room",
            "name": "Living Room"
          }
        },
        {
          "id": "card-thermo-bedroom",
          "type": "thermostat",
          "colSpan": 4,
          "config": {
            "entity": "climate.bedroom",
            "name": "Bedroom"
          }
        },
        {
          "id": "card-thermo-office",
          "type": "thermostat",
          "colSpan": 4,
          "config": {
            "entity": "climate.office",
            "name": "Office"
          }
        },
        {
          "id": "card-temp-sensors",
          "type": "entities",
          "colSpan": 6,
          "config": {
            "title": "Temperature Sensors",
            "entities": [
              {"entity": "sensor.living_room_temperature", "name": "Living Room"},
              {"entity": "sensor.bedroom_temperature", "name": "Bedroom"},
              {"entity": "sensor.outdoor_temperature", "name": "Outdoor"},
              {"entity": "sensor.humidity", "name": "Humidity"}
            ]
          }
        },
        {
          "id": "card-temp-history",
          "type": "history-graph",
          "colSpan": 6,
          "config": {
            "title": "Temperature History",
            "entities": [
              {"entity": "sensor.living_room_temperature"},
              {"entity": "sensor.outdoor_temperature"}
            ],
            "hours_to_show": 48
          }
        }
      ]
    },
    {
      "id": "view-security",
      "title": "Security",
      "path": "security",
      "icon": "mdi:shield",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-alarm",
          "type": "alarm-panel",
          "colSpan": 6,
          "config": {
            "entity": "alarm_control_panel.home",
            "name": "Home Alarm"
          }
        },
        {
          "id": "card-door-sensors",
          "type": "entities",
          "colSpan": 6,
          "config": {
            "title": "Doors & Windows",
            "entities": [
              {"entity": "binary_sensor.front_door", "name": "Front Door"},
              {"entity": "binary_sensor.back_door", "name": "Back Door"},
              {"entity": "binary_sensor.garage_door", "name": "Garage Door"},
              {"entity": "binary_sensor.living_room_window", "name": "Living Room Window"},
              {"entity": "binary_sensor.bedroom_window", "name": "Bedroom Window"}
            ]
          }
        },
        {
          "id": "card-camera-front",
          "type": "picture-glance",
          "colSpan": 6,
          "config": {
            "title": "Front Door",
            "camera_image": "camera.front_door",
            "entities": [
              "binary_sensor.front_door",
              "lock.front_door"
            ]
          }
        },
        {
          "id": "card-camera-back",
          "type": "picture-glance",
          "colSpan": 6,
          "config": {
            "title": "Back Yard",
            "camera_image": "camera.backyard",
            "entities": [
              "binary_sensor.backyard_motion",
              "light.backyard"
            ]
          }
        }
      ]
    },
    {
      "id": "view-media",
      "title": "Media",
      "path": "media",
      "icon": "mdi:television-play",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-tv",
          "type": "media-control",
          "colSpan": 6,
          "config": {
            "entity": "media_player.living_room_tv",
            "name": "Living Room TV"
          }
        },
        {
          "id": "card-speaker-living",
          "type": "media-control",
          "colSpan": 6,
          "config": {
            "entity": "media_player.living_room_speaker",
            "name": "Living Room Speaker"
          }
        },
        {
          "id": "card-speaker-kitchen",
          "type": "media-control",
          "colSpan": 4,
          "config": {
            "entity": "media_player.kitchen_speaker",
            "name": "Kitchen"
          }
        },
        {
          "id": "card-speaker-bedroom",
          "type": "media-control",
          "colSpan": 4,
          "config": {
            "entity": "media_player.bedroom_speaker",
            "name": "Bedroom"
          }
        },
        {
          "id": "card-speaker-office",
          "type": "media-control",
          "colSpan": 4,
          "config": {
            "entity": "media_player.office_speaker",
            "name": "Office"
          }
        }
      ]
    }
  ]
}
