{
  "id": "tpl-mobile-first",
  "title": "Mobile First",
  "views": [
    {
      "id": "view-mobile-home",
      "title": "Home",
      "path": "mobile-home",
      "icon": "mdi:home",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-m-weather",
          "type": "weather-forecast",
          "colSpan": 12,
          "config": {
            "entity": "weather.home",
            "show_forecast": true,
            "forecast_type": "hourly"
          }
        },
        {
          "id": "card-m-who-home",
          "type": "glance",
          "colSpan": 12,
          "config": {
            "title": "Who's Home",
            "entities": ["person.john", "person.sarah"],
            "show_state": true
          }
        },
        {
          "id": "card-m-quick",
          "type": "entities",
          "colSpan": 12,
          "config": {
            "title": "Quick Controls",
            "entities": [
              {"entity": "light.living_room", "name": "Living Room Lights"},
              {"entity": "climate.living_room", "name": "Thermostat"},
              {"entity": "lock.front_door", "name": "Front Door"},
              {"entity": "cover.garage_door", "name": "Garage"},
              {"entity": "alarm_control_panel.home", "name": "Alarm"}
            ]
          }
        },
        {
          "id": "card-m-lights",
          "type": "entities",
          "colSpan": 12,
          "config": {
            "title": "All Lights",
            "entities": [
              {"entity": "light.living_room", "name": "Living Room"},
              {"entity": "light.kitchen", "name": "Kitchen"},
              {"entity": "light.bedroom", "name": "Bedroom"},
              {"entity": "light.office", "name": "Office"},
              {"entity": "light.bathroom", "name": "Bathroom"},
              {"entity": "light.garage", "name": "Garage"}
            ]
          }
        },
        {
          "id": "card-m-climate",
          "type": "thermostat",
          "colSpan": 12,
          "config": {
            "entity": "climate.living_room",
            "name": "Living Room Thermostat"
          }
        },
        {
          "id": "card-m-media",
          "type": "media-control",
          "colSpan": 12,
          "config": {
            "entity": "media_player.living_room_speaker",
            "name": "Now Playing"
          }
        }
      ]
    },
    {
      "id": "view-mobile-status",
      "title": "Status",
      "path": "mobile-status",
      "icon": "mdi:information",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-m-sensors",
          "type": "entities",
          "colSpan": 12,
          "config": {
            "title": "Sensors",
            "entities": [
              {"entity": "sensor.outdoor_temperature", "name": "Outdoor Temp"},
              {"entity": "sensor.living_room_temperature", "name": "Indoor Temp"},
              {"entity": "sensor.humidity", "name": "Humidity"},
              {"entity": "sensor.power_consumption", "name": "Power Usage"},
              {"entity": "sensor.energy_today", "name": "Energy Today"}
            ]
          }
        },
        {
          "id": "card-m-security",
          "type": "entities",
          "colSpan": 12,
          "config": {
            "title": "Security",
            "entities": [
              {"entity": "binary_sensor.front_door", "name": "Front Door"},
              {"entity": "binary_sensor.back_door", "name": "Back Door"},
              {"entity": "binary_sensor.garage_door", "name": "Garage"},
              {"entity": "binary_sensor.motion_living_room", "name": "Motion: Living Room"},
              {"entity": "binary_sensor.motion_hallway", "name": "Motion: Hallway"}
            ]
          }
        },
        {
          "id": "card-m-energy",
          "type": "statistics-graph",
          "colSpan": 12,
          "config": {
            "title": "Energy (24h)",
            "entities": [{"entity": "sensor.power_consumption"}],
            "period": "hour",
            "chart_type": "line",
            "days_to_show": 1
          }
        },
        {
          "id": "card-m-log",
          "type": "logbook",
          "colSpan": 12,
          "config": {
            "title": "Recent Activity",
            "hours_to_show": 6
          }
        }
      ]
    }
  ]
}
