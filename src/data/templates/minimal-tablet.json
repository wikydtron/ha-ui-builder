{
  "id": "tpl-minimal-tablet",
  "title": "Minimal Tablet",
  "views": [
    {
      "id": "view-home",
      "title": "Home",
      "path": "home",
      "icon": "mdi:home",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-welcome",
          "type": "markdown",
          "colSpan": 12,
          "config": {
            "content": "## Welcome Home\n*{{ now().strftime('%A, %B %d') }}* • {{ states('sensor.outdoor_temperature') }}°C outside"
          }
        },
        {
          "id": "card-btn-lights",
          "type": "button",
          "colSpan": 3,
          "config": {
            "entity": "light.all_lights",
            "name": "All Lights",
            "icon": "mdi:lightbulb-group",
            "tap_action": {"action": "toggle"},
            "show_state": true
          }
        },
        {
          "id": "card-btn-lock",
          "type": "button",
          "colSpan": 3,
          "config": {
            "entity": "lock.front_door",
            "name": "Front Door",
            "icon": "mdi:lock",
            "tap_action": {"action": "toggle"},
            "show_state": true
          }
        },
        {
          "id": "card-btn-garage",
          "type": "button",
          "colSpan": 3,
          "config": {
            "entity": "cover.garage_door",
            "name": "Garage",
            "icon": "mdi:garage",
            "tap_action": {"action": "toggle"},
            "show_state": true
          }
        },
        {
          "id": "card-btn-alarm",
          "type": "button",
          "colSpan": 3,
          "config": {
            "entity": "alarm_control_panel.home",
            "name": "Alarm",
            "icon": "mdi:shield-home",
            "show_state": true
          }
        },
        {
          "id": "card-weather-simple",
          "type": "weather-forecast",
          "colSpan": 6,
          "config": {
            "entity": "weather.home",
            "show_forecast": true,
            "forecast_type": "daily"
          }
        },
        {
          "id": "card-who-home",
          "type": "glance",
          "colSpan": 6,
          "config": {
            "title": "Who's Home",
            "entities": [
              "person.john",
              "person.sarah",
              "person.emma",
              "person.jake"
            ],
            "show_state": true,
            "columns": 2
          }
        }
      ]
    },
    {
      "id": "view-rooms",
      "title": "Rooms",
      "path": "rooms",
      "icon": "mdi:floor-plan",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-room-living",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Living Room",
            "entities": [
              {"entity": "light.living_room", "name": "Lights"},
              {"entity": "climate.living_room", "name": "Climate"},
              {"entity": "media_player.living_room_tv", "name": "TV"},
              {"entity": "sensor.living_room_temperature", "name": "Temperature"}
            ]
          }
        },
        {
          "id": "card-room-kitchen",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Kitchen",
            "entities": [
              {"entity": "light.kitchen", "name": "Lights"},
              {"entity": "sensor.kitchen_temperature", "name": "Temperature"},
              {"entity": "switch.coffee_maker", "name": "Coffee Maker"},
              {"entity": "sensor.kitchen_humidity", "name": "Humidity"}
            ]
          }
        },
        {
          "id": "card-room-bedroom",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Bedroom",
            "entities": [
              {"entity": "light.bedroom", "name": "Lights"},
              {"entity": "climate.bedroom", "name": "Climate"},
              {"entity": "media_player.bedroom_tv", "name": "TV"},
              {"entity": "sensor.bedroom_temperature", "name": "Temperature"}
            ]
          }
        },
        {
          "id": "card-room-office",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Office",
            "entities": [
              {"entity": "light.office", "name": "Lights"},
              {"entity": "climate.office", "name": "Climate"},
              {"entity": "switch.desk_power", "name": "Desk Power"},
              {"entity": "sensor.office_co2", "name": "CO₂"}
            ]
          }
        },
        {
          "id": "card-room-bathroom",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Bathroom",
            "entities": [
              {"entity": "light.bathroom", "name": "Lights"},
              {"entity": "fan.bathroom_fan", "name": "Fan"},
              {"entity": "sensor.bathroom_humidity", "name": "Humidity"},
              {"entity": "binary_sensor.bathroom_motion", "name": "Motion"}
            ]
          }
        },
        {
          "id": "card-room-garage",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Garage",
            "entities": [
              {"entity": "cover.garage_door", "name": "Door"},
              {"entity": "light.garage", "name": "Lights"},
              {"entity": "sensor.garage_temperature", "name": "Temperature"},
              {"entity": "switch.ev_charger", "name": "EV Charger"}
            ]
          }
        }
      ]
    }
  ]
}
