{
  "id": "tpl-desktop-poweruser",
  "title": "Desktop Power User",
  "views": [
    {
      "id": "view-desk-overview",
      "title": "Overview",
      "path": "desk-overview",
      "icon": "mdi:view-dashboard",
      "viewType": "sections",
      "cards": [
        {
          "id": "card-d-weather",
          "type": "weather-forecast",
          "colSpan": 3,
          "config": {
            "entity": "weather.home",
            "show_forecast": true,
            "forecast_type": "daily"
          }
        },
        {
          "id": "card-d-people",
          "type": "glance",
          "colSpan": 3,
          "config": {
            "title": "People",
            "entities": ["person.john", "person.sarah", "person.emma", "person.jake"],
            "show_state": true,
            "columns": 2
          }
        },
        {
          "id": "card-d-power",
          "type": "sensor",
          "colSpan": 3,
          "config": {
            "entity": "sensor.power_consumption",
            "name": "Current Power",
            "graph": "line",
            "unit": "W"
          }
        },
        {
          "id": "card-d-alarm",
          "type": "alarm-panel",
          "colSpan": 3,
          "config": {
            "entity": "alarm_control_panel.home",
            "name": "Alarm"
          }
        },
        {
          "id": "card-d-lights",
          "type": "entities",
          "colSpan": 3,
          "config": {
            "title": "Lights",
            "entities": [
              "light.living_room",
              "light.kitchen",
              "light.bedroom",
              "light.office"
            ]
          }
        },
        {
          "id": "card-d-climate-1",
          "type": "thermostat",
          "colSpan": 3,
          "config": {"entity": "climate.living_room", "name": "Living"}
        },
        {
          "id": "card-d-climate-2",
          "type": "thermostat",
          "colSpan": 3,
          "config": {"entity": "climate.bedroom", "name": "Bedroom"}
        },
        {
          "id": "card-d-media-main",
          "type": "media-control",
          "colSpan": 3,
          "config": {"entity": "media_player.living_room_tv", "name": "Living Room TV"}
        },
        {
          "id": "card-d-energy-bar",
          "type": "statistics-graph",
          "colSpan": 12,
          "config": {
            "title": "Today's Energy by Hour",
            "entities": [{"entity": "sensor.power_consumption"}],
            "period": "hour",
            "chart_type": "bar",
            "days_to_show": 1
          }
        }
      ]
    },
    {
      "id": "view-desk-home",
      "title": "Smart Home",
      "path": "desk-home",
      "icon": "mdi:home-automation",
      "viewType": "sections",
      "cards": [
        {
          "id": "card-dh-scene-morning",
          "type": "button",
          "colSpan": 2,
          "config": {"entity": "scene.morning", "name": "Morning", "icon": "mdi:weather-sunrise"}
        },
        {
          "id": "card-dh-scene-day",
          "type": "button",
          "colSpan": 2,
          "config": {"entity": "scene.day", "name": "Day Mode", "icon": "mdi:weather-sunny"}
        },
        {
          "id": "card-dh-scene-evening",
          "type": "button",
          "colSpan": 2,
          "config": {"entity": "scene.evening", "name": "Evening", "icon": "mdi:weather-sunset"}
        },
        {
          "id": "card-dh-scene-movie",
          "type": "button",
          "colSpan": 2,
          "config": {"entity": "scene.movie_time", "name": "Movie Time", "icon": "mdi:movie"}
        },
        {
          "id": "card-dh-scene-sleep",
          "type": "button",
          "colSpan": 2,
          "config": {"entity": "scene.goodnight", "name": "Good Night", "icon": "mdi:weather-night"}
        },
        {
          "id": "card-dh-scene-away",
          "type": "button",
          "colSpan": 2,
          "config": {"entity": "scene.leaving_home", "name": "Leave Home", "icon": "mdi:exit-run"}
        },
        {
          "id": "card-dh-automations",
          "type": "entities",
          "colSpan": 6,
          "config": {
            "title": "Automations",
            "entities": [
              "automation.morning_routine",
              "automation.evening_lights",
              "automation.away_mode",
              "automation.bedtime",
              "automation.motion_lights_living_room",
              "automation.climate_eco_mode"
            ]
          }
        },
        {
          "id": "card-dh-scripts",
          "type": "entities",
          "colSpan": 6,
          "config": {
            "title": "Scripts",
            "entities": [
              "script.all_lights_off",
              "script.movie_mode",
              "script.good_morning",
              "script.lock_all",
              "script.reset_thermostats"
            ]
          }
        }
      ]
    },
    {
      "id": "view-desk-energy",
      "title": "Energy",
      "path": "desk-energy",
      "icon": "mdi:lightning-bolt",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-de-now",
          "type": "sensor",
          "colSpan": 2,
          "config": {"entity": "sensor.power_consumption", "name": "Now (W)", "graph": "line"}
        },
        {
          "id": "card-de-today",
          "type": "sensor",
          "colSpan": 2,
          "config": {"entity": "sensor.energy_today", "name": "Today (kWh)"}
        },
        {
          "id": "card-de-month",
          "type": "sensor",
          "colSpan": 2,
          "config": {"entity": "sensor.energy_month", "name": "Month (kWh)"}
        },
        {
          "id": "card-de-solar",
          "type": "sensor",
          "colSpan": 2,
          "config": {"entity": "sensor.solar_power", "name": "Solar (W)", "graph": "line"}
        },
        {
          "id": "card-de-cost",
          "type": "sensor",
          "colSpan": 2,
          "config": {"entity": "sensor.energy_cost_month", "name": "Cost ($)"}
        },
        {
          "id": "card-de-battery",
          "type": "gauge",
          "colSpan": 2,
          "config": {"entity": "sensor.battery_level", "name": "Battery", "min": 0, "max": 100, "unit": "%"}
        },
        {
          "id": "card-de-power-graph",
          "type": "statistics-graph",
          "colSpan": 8,
          "config": {
            "title": "Power vs Solar",
            "entities": [
              {"entity": "sensor.power_consumption", "name": "Consumption"},
              {"entity": "sensor.solar_power", "name": "Solar"}
            ],
            "period": "hour",
            "chart_type": "line",
            "days_to_show": 1
          }
        },
        {
          "id": "card-de-appliances",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Top Consumers",
            "entities": [
              {"entity": "sensor.ac_power", "name": "A/C"},
              {"entity": "sensor.ev_charger_power", "name": "EV Charger"},
              {"entity": "sensor.washing_machine_power", "name": "Washer"},
              {"entity": "sensor.dryer_power", "name": "Dryer"},
              {"entity": "sensor.oven_power", "name": "Oven"}
            ]
          }
        }
      ]
    },
    {
      "id": "view-desk-network",
      "title": "Network",
      "path": "desk-network",
      "icon": "mdi:router-network",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-dn-router",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Network Status",
            "entities": [
              {"entity": "sensor.speedtest_download", "name": "Download"},
              {"entity": "sensor.speedtest_upload", "name": "Upload"},
              {"entity": "sensor.speedtest_ping", "name": "Ping"},
              {"entity": "binary_sensor.internet", "name": "Internet"},
              {"entity": "sensor.connected_devices", "name": "Devices Connected"}
            ]
          }
        },
        {
          "id": "card-dn-ha-server",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "HA Server",
            "entities": [
              {"entity": "sensor.processor_use", "name": "CPU"},
              {"entity": "sensor.memory_use_percent", "name": "RAM"},
              {"entity": "sensor.disk_use_percent", "name": "Disk"},
              {"entity": "sensor.processor_temperature", "name": "Temp"},
              {"entity": "sensor.last_boot", "name": "Last Boot"}
            ]
          }
        },
        {
          "id": "card-dn-smart-devices",
          "type": "entities",
          "colSpan": 4,
          "config": {
            "title": "Smart Devices",
            "entities": [
              {"entity": "sensor.zigbee_devices_online", "name": "Zigbee Devices"},
              {"entity": "sensor.zwave_devices", "name": "Z-Wave Devices"},
              {"entity": "sensor.wifi_devices", "name": "WiFi Devices"},
              {"entity": "update.home_assistant_core_update", "name": "HA Update"}
            ]
          }
        },
        {
          "id": "card-dn-speed-history",
          "type": "statistics-graph",
          "colSpan": 12,
          "config": {
            "title": "Internet Speed History",
            "entities": [
              {"entity": "sensor.speedtest_download", "name": "Download"},
              {"entity": "sensor.speedtest_upload", "name": "Upload"}
            ],
            "period": "hour",
            "chart_type": "line",
            "days_to_show": 7
          }
        }
      ]
    },
    {
      "id": "view-desk-admin",
      "title": "Admin",
      "path": "desk-admin",
      "icon": "mdi:shield-crown",
      "viewType": "masonry",
      "cards": [
        {
          "id": "card-da-updates",
          "type": "entities",
          "colSpan": 6,
          "config": {
            "title": "Updates",
            "entities": [
              "update.home_assistant_core_update",
              "update.home_assistant_supervisor_update",
              "update.home_assistant_os_update"
            ]
          }
        },
        {
          "id": "card-da-addons",
          "type": "entities",
          "colSpan": 6,
          "config": {
            "title": "Add-ons",
            "entities": [
              {"entity": "sensor.mosquitto_broker_cpu", "name": "MQTT CPU"},
              {"entity": "sensor.zigbee2mqtt_cpu", "name": "Z2M CPU"},
              {"entity": "sensor.node_red_cpu", "name": "Node-RED CPU"}
            ]
          }
        },
        {
          "id": "card-da-logs",
          "type": "logbook",
          "colSpan": 12,
          "config": {
            "title": "System Log",
            "hours_to_show": 24
          }
        }
      ]
    }
  ]
}
