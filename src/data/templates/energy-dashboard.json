{
  "id": "tpl-energy-dashboard",
  "title": "Energy Dashboard",
  "views": [
    {
      "id": "view-energy-overview",
      "title": "Overview",
      "path": "energy",
      "icon": "mdi:lightning-bolt",
      "layout": "masonry",
      "cards": [
        {
          "id": "card-gauge-solar",
          "type": "gauge",
          "config": {
            "entity": "sensor.solar_power",
            "name": "Solar Production",
            "min": 0,
            "max": 5000,
            "unit": "W",
            "severity": {
              "green": 2000,
              "yellow": 500,
              "red": 0
            }
          }
        },
        {
          "id": "card-gauge-power",
          "type": "gauge",
          "config": {
            "entity": "sensor.power_consumption",
            "name": "Consumption",
            "min": 0,
            "max": 5000,
            "unit": "W",
            "severity": {
              "green": 0,
              "yellow": 2000,
              "red": 3500
            }
          }
        },
        {
          "id": "card-energy-summary",
          "type": "entities",
          "config": {
            "title": "Today's Energy",
            "entities": [
              "sensor.energy_daily",
              "sensor.solar_power",
              "sensor.power_consumption"
            ]
          }
        },
        {
          "id": "card-history-power",
          "type": "history-graph",
          "config": {
            "title": "Power — Last 24h",
            "entities": [
              { "entity": "sensor.solar_power", "name": "Solar" },
              { "entity": "sensor.power_consumption", "name": "Usage" }
            ],
            "hours_to_show": 24,
            "refresh_interval": 60
          }
        },
        {
          "id": "card-markdown-energy",
          "type": "markdown",
          "config": {
            "content": "## ⚡ Energy Summary\n\n☀️ **Solar Now:** {{ states('sensor.solar_power') }} W\n🔌 **Usage Now:** {{ states('sensor.power_consumption') }} W\n📅 **Today:** {{ states('sensor.energy_daily') }} kWh"
          }
        }
      ]
    },
    {
      "id": "view-solar",
      "title": "Solar",
      "path": "solar",
      "icon": "mdi:solar-power",
      "layout": "masonry",
      "cards": [
        {
          "id": "card-solar-gauge",
          "type": "gauge",
          "config": {
            "entity": "sensor.solar_power",
            "name": "Solar Output",
            "min": 0,
            "max": 5000,
            "unit": "W",
            "severity": {
              "green": 2000,
              "yellow": 800,
              "red": 0
            }
          }
        },
        {
          "id": "card-solar-history",
          "type": "history-graph",
          "config": {
            "title": "Solar Production — 7 Days",
            "entities": [
              { "entity": "sensor.solar_power", "name": "Solar W" }
            ],
            "hours_to_show": 168,
            "refresh_interval": 300
          }
        },
        {
          "id": "card-solar-entity",
          "type": "entity",
          "config": {
            "entity": "sensor.solar_power",
            "name": "Current Solar Output",
            "icon": "mdi:solar-power-variant"
          }
        }
      ]
    },
    {
      "id": "view-appliances",
      "title": "Appliances",
      "path": "appliances",
      "icon": "mdi:washing-machine",
      "layout": "masonry",
      "cards": [
        {
          "id": "card-washing-power",
          "type": "entity",
          "config": {
            "entity": "sensor.washing_machine_power",
            "name": "Washing Machine",
            "icon": "mdi:washing-machine"
          }
        },
        {
          "id": "card-washing-binary",
          "type": "entity",
          "config": {
            "entity": "binary_sensor.washing_machine",
            "name": "Running",
            "icon": "mdi:washing-machine"
          }
        },
        {
          "id": "card-switches-energy",
          "type": "entities",
          "config": {
            "title": "Controllable Loads",
            "entities": [
              "switch.coffee_maker",
              "switch.garage_heater",
              "switch.office_monitor_power",
              "switch.living_room_outlet"
            ],
            "state_color": true
          }
        },
        {
          "id": "card-appliance-history",
          "type": "history-graph",
          "config": {
            "title": "Appliance Power — 24h",
            "entities": [
              { "entity": "sensor.washing_machine_power", "name": "Washing Machine" }
            ],
            "hours_to_show": 24
          }
        }
      ]
    },
    {
      "id": "view-energy-history",
      "title": "History",
      "path": "energy-history",
      "icon": "mdi:chart-line",
      "layout": "masonry",
      "cards": [
        {
          "id": "card-daily-history",
          "type": "history-graph",
          "config": {
            "title": "Daily Energy",
            "entities": [
              { "entity": "sensor.energy_daily", "name": "kWh" }
            ],
            "hours_to_show": 168
          }
        },
        {
          "id": "card-power-history-week",
          "type": "history-graph",
          "config": {
            "title": "Solar vs Consumption — 7 Days",
            "entities": [
              { "entity": "sensor.solar_power", "name": "Solar" },
              { "entity": "sensor.power_consumption", "name": "Consumed" }
            ],
            "hours_to_show": 168,
            "refresh_interval": 600
          }
        }
      ]
    }
  ]
}
